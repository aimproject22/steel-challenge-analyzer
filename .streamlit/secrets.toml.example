# Copy to .streamlit/secrets.toml for local use. The real file is gitignored.
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY"

# Optional: enables the administrator-only Auth invitation form.
# Keep this server-side; never expose it in browser code or screenshots.
SUPABASE_SERVICE_ROLE_KEY = "YOUR_SUPABASE_SERVICE_ROLE_KEY"
PUBLIC_ACCESS_ENABLED = false

# Gmail values are primarily used by the scheduled GitHub Actions worker.
GMAIL_CLIENT_ID = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
GMAIL_CLIENT_SECRET = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GMAIL_REFRESH_TOKEN = "YOUR_GOOGLE_REFRESH_TOKEN"
GMAIL_TARGET_ADDRESS = "steelchallenge318@gmail.com"
